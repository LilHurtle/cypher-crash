# Dev / Play-test mode
# Set to "true" to bypass Google login for local play-testing.
# The app logs you in automatically as "Dev Player" — no Supabase account needed.
# WARNING: NEVER set this to true in production.
VITE_DEV_MODE="false"

# API base URL (leave blank to use Vite proxy in dev)
VITE_API_URL="http://localhost:3001"

# Supabase (only needed when VITE_DEV_MODE=false)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
