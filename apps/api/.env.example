# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cypher_crash"

# Dev / Play-test mode
# Set to "true" to bypass JWT auth for local play-testing.
# The API accepts "Bearer dev-local-token" and uses a hardcoded dev user.
# WARNING: NEVER set this to true in production.
DEV_MODE="false"

# Daily Word HMAC secret (any random string)
DAILY_SECRET="change-me-to-a-long-random-string"

# Web app URL (for Stripe redirect)
WEB_URL="http://localhost:5173"

# Supabase (only needed when DEV_MODE=false)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Stripe (optional - leave blank to use dev-mode instant upgrade)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_BATTLE_PASS_PRICE_ID="price_..."
