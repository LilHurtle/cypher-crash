# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (local dev example)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cypher_crash"

# ── Supabase (for JWT verification) ───────────────────────────────────────────
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# ── Battle Pass / Stripe ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_BATTLE_PASS_PRICE_ID="price_..."

# Web app URL (for Stripe redirect)
WEB_URL="http://localhost:5173"

# ── Daily Word HMAC secret ─────────────────────────────────────────────────────
# Random string used to derive daily word length + word selection
DAILY_SECRET="change-me-to-a-long-random-string"
